<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key>
  <string>Moss</string>
  <key>settings</key>
  <array>
    <!-- Base editor surface: deep pine background, mint foreground -->
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key>
        <string>#1c231a</string>
        <key>foreground</key>
        <string>#cce0d8</string>
        <key>caret</key>
        <string>#88c4b8</string>
        <key>lineHighlight</key>
        <string>#2a3426</string>
        <key>selection</key>
        <string>#3a4a36</string>
      </dict>
    </dict>

    <!-- Comments: dim moss-in-shade, italic. Recedes visually. -->
    <dict>
      <key>name</key>
      <string>Comment</string>
      <key>scope</key>
      <string>comment, comment.line, comment.block, punctuation.definition.comment</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#6a8088</string>
        <key>fontStyle</key>
        <string>italic</string>
      </dict>
    </dict>

    <!-- Strings: cool sky blue. Distinctly BLUE against the green body
         so you can spot a string literal at a glance. -->
    <dict>
      <key>name</key>
      <string>String</string>
      <key>scope</key>
      <string>string, string.quoted, string.quoted.double, string.quoted.single, string.quoted.triple</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#7c9cc4</string>
      </dict>
    </dict>

    <!-- String punctuation (the actual quote marks): muted blue -->
    <dict>
      <key>name</key>
      <string>String punctuation</string>
      <key>scope</key>
      <string>punctuation.definition.string, punctuation.definition.string.begin, punctuation.definition.string.end</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#5070a0</string>
      </dict>
    </dict>

    <!-- Escape sequences inside strings: slightly brighter sky-blue -->
    <dict>
      <key>name</key>
      <string>String escape</string>
      <key>scope</key>
      <string>constant.character.escape, string.regexp</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#88b4d8</string>
      </dict>
    </dict>

    <!-- String interpolation (Swift "\(x)", Scala s"$x", Ruby #{x}):
         bright pine-teal so the embedded expressions pop out -->
    <dict>
      <key>name</key>
      <string>String interpolation</string>
      <key>scope</key>
      <string>punctuation.section.interpolation, meta.interpolation, source.swift string.interpolated</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#7cc4c4</string>
      </dict>
    </dict>

    <!-- Numbers: pale sage. Lighter than body so digits pop. -->
    <dict>
      <key>name</key>
      <string>Number</string>
      <key>scope</key>
      <string>constant.numeric, constant.numeric.integer, constant.numeric.float</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#a8d8c8</string>
      </dict>
    </dict>

    <!-- Language constants (true/false/nil/None/Some): bright pine-teal -->
    <dict>
      <key>name</key>
      <string>Language constant</string>
      <key>scope</key>
      <string>constant.language, support.constant, constant.other</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#7caab0</string>
      </dict>
    </dict>

    <!-- Keywords (if, for, return, func, let, var, class, …):
         bright pine-teal, bold. The strongest visual anchor. -->
    <dict>
      <key>name</key>
      <string>Keyword</string>
      <key>scope</key>
      <string>keyword, keyword.control, keyword.other, keyword.declaration</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#5fb8b8</string>
        <key>fontStyle</key>
        <string>bold</string>
      </dict>
    </dict>

    <!-- Storage modifiers (func, let, var, class, struct, pub):
         same family as keyword but not bold, for visual relief -->
    <dict>
      <key>name</key>
      <string>Storage</string>
      <key>scope</key>
      <string>storage, storage.type, storage.modifier, keyword.type</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#6ea0a0</string>
        <key>fontStyle</key>
        <string>bold</string>
      </dict>
    </dict>

    <!-- Operators (=, +, -, →, etc.): muted sage -->
    <dict>
      <key>name</key>
      <string>Operator</string>
      <key>scope</key>
      <string>keyword.operator, punctuation.accessor</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#90b4a8</string>
      </dict>
    </dict>

    <!-- Punctuation (braces, brackets, semicolons): deeper sage -->
    <dict>
      <key>name</key>
      <string>Punctuation</string>
      <key>scope</key>
      <string>punctuation, punctuation.terminator, punctuation.section, punctuation.separator</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#788c90</string>
      </dict>
    </dict>

    <!-- Function NAMES at declaration: fresh moss, bold -->
    <dict>
      <key>name</key>
      <string>Function declaration</string>
      <key>scope</key>
      <string>entity.name.function, entity.name.method, meta.function entity.name</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#9cd8c0</string>
        <key>fontStyle</key>
        <string>bold</string>
      </dict>
    </dict>

    <!-- Function CALLS: same as decl but not bold -->
    <dict>
      <key>name</key>
      <string>Function call</string>
      <key>scope</key>
      <string>support.function, meta.function-call, variable.function</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#9cd8c0</string>
      </dict>
    </dict>

    <!-- Types / classes / structs / traits / interfaces / enums:
         distinct sage-teal so type names are obviously types -->
    <dict>
      <key>name</key>
      <string>Type</string>
      <key>scope</key>
      <string>entity.name.type, entity.name.class, entity.name.struct, entity.name.trait, entity.name.interface, entity.name.enum, support.class, support.type, meta.type</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#88b8a4</string>
      </dict>
    </dict>

    <!-- Generic type parameters (T, U, etc.): lighter teal -->
    <dict>
      <key>name</key>
      <string>Generic parameter</string>
      <key>scope</key>
      <string>variable.parameter.type, meta.generic</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#a4c4b4</string>
      </dict>
    </dict>

    <!-- Variable names and parameters: default sage foreground -->
    <dict>
      <key>name</key>
      <string>Variable</string>
      <key>scope</key>
      <string>variable, variable.other, variable.parameter, meta.definition.variable</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#cce0d8</string>
      </dict>
    </dict>

    <!-- Property / member access (obj.foo): muted moss, distinct
         from plain variables so you can spot field access -->
    <dict>
      <key>name</key>
      <string>Member / property</string>
      <key>scope</key>
      <string>variable.other.member, variable.other.property, meta.property-name, support.type.property-name</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#9cc4b8</string>
      </dict>
    </dict>

    <!-- Preprocessor / macros / attributes (#include, #[derive], @objc):
         deep pine, bold -->
    <dict>
      <key>name</key>
      <string>Preprocessor / macro / attribute</string>
      <key>scope</key>
      <string>meta.preprocessor, keyword.preprocessor, entity.name.macro, meta.annotation, meta.attribute, support.other.attribute</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#5c9694</string>
        <key>fontStyle</key>
        <string>bold</string>
      </dict>
    </dict>

    <!-- HTML / XML / JSX tags: pine-teal -->
    <dict>
      <key>name</key>
      <string>Tag</string>
      <key>scope</key>
      <string>entity.name.tag, meta.tag</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#5fb8b8</string>
      </dict>
    </dict>

    <!-- Tag attribute names: muted moss -->
    <dict>
      <key>name</key>
      <string>Tag attribute</string>
      <key>scope</key>
      <string>entity.other.attribute-name</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#9cc4b8</string>
      </dict>
    </dict>

    <!-- Invalid / error tokens: weathered iron-oxide (bold). Errors
         still need to stand out — this is the one warm tone, kept
         deep and earthy rather than fire-red. -->
    <dict>
      <key>name</key>
      <string>Invalid</string>
      <key>scope</key>
      <string>invalid, invalid.illegal, invalid.deprecated</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#9e5444</string>
        <key>fontStyle</key>
        <string>bold</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
